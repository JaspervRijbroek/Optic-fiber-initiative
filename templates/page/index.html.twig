{% extends 'page/layout.html.twig' %}

{% block title %}Regístrate{% endblock %}

{% block head %}
  <!-- Cloudflare Turnstile -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endblock %}

{% block body_extra_classes %}justify-center{% endblock %}

{% block content %}

  <!-- Signup form -->
  <div id="form-section">
    {% include 'page/_logo.html.twig' %}

    <h1 class="text-2xl font-bold text-[#1a237e] text-center mb-1">Fibra Óptica en tu Zona</h1>
    <p class="text-center text-slate-500 text-sm mb-8 leading-relaxed">
      Regístrate para mostrar tu interés en recibir fibra óptica.<br>
      Cuantos más vecinos se registren, ¡antes llegará!
    </p>

    <div id="server-error" class="hidden bg-red-50 border border-red-300 rounded-lg px-4 py-3 text-red-700 text-sm mb-4" role="alert"></div>

    <form id="signup-form" novalidate>

      <div class="mb-5">
        <label for="nombre" class="block text-xs font-semibold text-slate-600 mb-1">
          Nombre completo <span aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="nombre"
          name="nombre"
          placeholder="Ej. María García López"
          autocomplete="name"
          required
          class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-base text-slate-800 outline-none transition-colors focus:border-[#1a237e] focus:ring-2 focus:ring-[#1a237e]/10"
        />
        <span class="hidden text-xs text-red-600 mt-1 block" id="nombre-error">Por favor, introduce tu nombre completo.</span>
      </div>

      <div class="mb-5">
        <label for="email" class="block text-xs font-semibold text-slate-600 mb-1">
          Correo electrónico <span aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="Ej. maria@email.com"
          autocomplete="email"
          required
          class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-base text-slate-800 outline-none transition-colors focus:border-[#1a237e] focus:ring-2 focus:ring-[#1a237e]/10"
        />
        <span class="hidden text-xs text-red-600 mt-1 block" id="email-error">Por favor, introduce un correo electrónico válido.</span>
      </div>

      <div class="mb-5">
        <label for="cadastral-reference" class="block text-xs font-semibold text-slate-600 mb-1">
          Referencia Catastral <span aria-hidden="true">*</span>
        </label>
        <div class="flex items-stretch gap-2">
          <input
            type="text"
            id="cadastral-reference"
            name="cadastral_reference"
            placeholder="Ej. 9872023VH5797S0001WX"
            maxlength="20"
            minlength="20"
            autocomplete="off"
            required
            class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-base text-slate-800 outline-none transition-colors focus:border-[#1a237e] focus:ring-2 focus:ring-[#1a237e]/10"
          />
          <button
            type="button"
            id="cadastral-reference-gps-btn"
            class="inline-flex items-center justify-center px-3 border border-slate-300 rounded-lg text-slate-700 hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-[#1a237e]/20 disabled:opacity-60 disabled:cursor-not-allowed"
            aria-label="Obtener referencia catastral mediante GPS"
            title="Obtener Referencia Catastral con GPS"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M11 2.05v2.02A8.002 8.002 0 0 0 4.07 11H2.05v2h2.02A8.002 8.002 0 0 0 11 19.93v2.02h2v-2.02A8.002 8.002 0 0 0 19.93 13h2.02v-2h-2.02A8.002 8.002 0 0 0 13 4.07V2.05h-2Zm1 4a6 6 0 1 1 0 12 6 6 0 0 1 0-12Zm0 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/>
            </svg>
          </button>
        </div>
        <span class="hidden text-xs text-red-600 mt-1 block" id="cadastral-reference-gps-error"></span>
        <div id="cadastral-reference-gps-status" class="hidden mt-1 text-xs text-slate-500" aria-live="polite"></div>
        <div id="cadastral-reference-gps-warning" class="hidden mt-2 bg-yellow-50 border border-yellow-300 rounded-lg px-3 py-2 text-xs text-yellow-800" role="alert"></div>
        <div id="cadastral-address" class="hidden mt-2 bg-green-50 border border-green-200 rounded-lg px-3 py-2 text-xs text-green-800" aria-live="polite">
          <span class="font-semibold">📍 Dirección:</span> <span id="cadastral-address-text"></span>
        </div>
        <div class="mt-2 bg-[#e8eaf6] rounded-lg px-3 py-2.5 text-xs text-[#1a237e] leading-relaxed">
          ℹ️ <strong>¿Dónde encontrarla?</strong> En el recibo del IBI (Impuesto sobre Bienes Inmuebles),
          en la escritura de tu propiedad, o consultándola en la
          <a href="https://www1.sedecatastro.gob.es/OVCFrames.aspx?TIPO=CONSULTA" target="_blank" rel="noopener noreferrer" class="underline hover:text-[#283593]">Sede Electrónica del Catastro</a>.
          Son siempre <strong>20 caracteres alfanuméricos</strong> (letras y números en mayúsculas).
        </div>
        <span class="hidden text-xs text-red-600 mt-1 block" id="cadastral-reference-error">La Referencia Catastral debe tener exactamente 20 caracteres alfanuméricos.</span>
      </div>

      <div id="cadastral-reference-duplicate-error" class="hidden bg-red-50 border border-red-300 rounded-lg px-4 py-3 text-red-700 text-sm mb-4" role="alert">
        Esta Referencia Catastral ya ha sido registrada. Si crees que es un error, contacta con nosotros.
      </div>

      <div class="mb-5">
        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            id="consent"
            name="consent"
            required
            aria-required="true"
            aria-describedby="consent-error"
            class="mt-0.5 h-4 w-4 flex-shrink-0 accent-[#1a237e] cursor-pointer"
          />
          <span class="text-xs text-slate-600 leading-relaxed">
            Acepto que mis datos (nombre, correo electrónico, Referencia Catastral y coordenadas GPS si se usan) sean compartidos con
            <strong>Movistar</strong> para gestionar la solicitud de instalación de fibra óptica en mi zona.
            <span class="sr-only">(obligatorio)</span>
          </span>
        </label>
        <span class="hidden text-xs text-red-600 mt-1 block" id="consent-error" role="alert">Debes aceptar el tratamiento de tus datos para continuar.</span>
      </div>

      <!-- Cloudflare Turnstile widget -->
      <div class="mb-5 flex justify-center">
        <div class="cf-turnstile" data-sitekey="{{ turnstileSiteKey }}" data-theme="light"></div>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="w-full py-3 bg-[#1a237e] text-white rounded-lg text-base font-semibold cursor-pointer transition-colors mt-2 hover:bg-[#283593] active:scale-[0.98] disabled:bg-slate-400 disabled:cursor-not-allowed"
      >
        Registrar mi interés
      </button>

    </form>

    <p class="mt-8 text-center text-xs text-slate-400">
      Tus datos únicamente se utilizarán para medir el interés en fibra óptica en tu zona<br>
      y serán compartidos con <strong>Movistar</strong>, empresa responsable del proyecto.
    </p>
    <p class="mt-3 text-center text-xs text-slate-400">
      ¿Conoces a alguien más? ¡Comparte esta página con tus vecinos!
    </p>
    <div class="mt-2 flex justify-center gap-3">
      <a
        id="form-share-whatsapp"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-white bg-[#25D366] hover:bg-[#1ebe5d] transition-colors no-underline"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        WhatsApp
      </a>
      <a
        id="form-share-telegram"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-white bg-[#0088cc] hover:bg-[#007ab8] transition-colors no-underline"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
        Telegram
      </a>
    </div>
  </div>

  <!-- Thank-you screen (hidden until form is submitted) -->
  <div id="thanks" class="hidden text-center" role="status" aria-live="polite">
    <svg class="w-20 h-20 mx-auto mb-5" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="36" cy="36" r="36" fill="#e8f5e9"/>
      <path d="M22 36 l10 10 l18-20" stroke="#2e7d32" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <h2 class="text-2xl font-bold text-[#1a237e] mb-2">¡Gracias por registrarte!</h2>
    <p class="text-slate-500 leading-relaxed text-sm">
      Hola, <span class="font-bold text-[#1a237e]" id="thanks-name"></span>.<br><br>
      Hemos recibido tu interés en recibir fibra óptica en tu zona.
      Cuantas más personas se registren, más rápido podremos avanzar con la instalación.
      Te hemos enviado un correo de confirmación y te contactaremos cuando haya novedades.
    </p>
    <p class="mt-6 text-sm text-slate-500 font-medium">
      ¿Conoces a alguien más que quiera fibra óptica? ¡Comparte esta página!
    </p>
    <div class="mt-3 flex justify-center gap-3">
      <a
        id="share-whatsapp"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold text-white bg-[#25D366] hover:bg-[#1ebe5d] transition-colors no-underline"
      >
        <!-- WhatsApp icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        WhatsApp
      </a>
      <a
        id="share-telegram"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold text-white bg-[#0088cc] hover:bg-[#007ab8] transition-colors no-underline"
      >
        <!-- Telegram icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
        Telegram
      </a>
    </div>
  </div>

  {% include 'page/_footer.html.twig' %}

{% endblock %}

{% block scripts %}
<script>
  (function () {
    'use strict';

    const $ = (id) => document.getElementById(id);
    const MAX_MOBILE_WIDTH_PX = 1024;
    const GEOLOCATION_PERMISSION_DENIED = 1;
    const GEOLOCATION_POSITION_UNAVAILABLE = 2;
    const GEOLOCATION_TIMEOUT = 3;

    // Build share URLs once and set on all share links
    (function initShareLinks() {
      const pageUrl  = encodeURIComponent(window.location.href);
      const shareMsg = encodeURIComponent(
        '¡Únete a la iniciativa de fibra óptica en nuestra zona! Cuantos más vecinos se registren, antes llegaremos a la meta. Regístrate aquí: '
      );
      const waUrl  = 'https://wa.me/?text=' + shareMsg + pageUrl;
      const tgUrl  = 'https://t.me/share/url?url=' + pageUrl + '&text=' + shareMsg;

      [$('share-whatsapp'), $('form-share-whatsapp')].forEach(function (el) {
        if (el) el.href = waUrl;
      });
      [$('share-telegram'), $('form-share-telegram')].forEach(function (el) {
        if (el) el.href = tgUrl;
      });
    })();

    function isValidEmail(val) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val.trim());
    }

    function setError(inputId, show) {
      const input = $(inputId);
      const errEl = $(inputId + '-error');
      if (!input || !errEl) return;
      if (show) {
        input.classList.add('border-red-600');
        input.classList.remove('border-slate-300');
        errEl.classList.remove('hidden');
      } else {
        input.classList.remove('border-red-600');
        input.classList.add('border-slate-300');
        errEl.classList.add('hidden');
      }
    }

    function setCheckboxError(show) {
      const errEl = $('consent-error');
      if (!errEl) return;
      if (show) {
        errEl.classList.remove('hidden');
      } else {
        errEl.classList.add('hidden');
      }
    }

    function showServerError(msg) {
      const el = $('server-error');
      el.textContent = msg;
      el.classList.remove('hidden');
    }

    function hideServerError() {
      const el = $('server-error');
      el.textContent = '';
      el.classList.add('hidden');
    }

    function setGpsError(message) {
      const el = $('cadastral-reference-gps-error');
      if (!el) return;
      if (!message) {
        el.textContent = '';
        el.classList.add('hidden');
        return;
      }

      el.textContent = message;
      el.classList.remove('hidden');
    }

    function setGpsStatus(message) {
      const el = $('cadastral-reference-gps-status');
      if (!el) return;
      if (!message) {
        el.textContent = '';
        el.classList.add('hidden');
        return;
      }

      el.textContent = message;
      el.classList.remove('hidden');
    }

    function setGpsWarning(message) {
      const el = $('cadastral-reference-gps-warning');
      if (!el) return;
      if (!message) {
        el.textContent = '';
        el.classList.add('hidden');
        return;
      }

      el.textContent = message;
      el.classList.remove('hidden');
    }

    function setCadastralAddress(address) {
      const container = $('cadastral-address');
      const text = $('cadastral-address-text');
      if (!container || !text) return;
      if (!address) {
        container.classList.add('hidden');
        text.textContent = '';
        return;
      }
      text.textContent = address;
      container.classList.remove('hidden');
    }

    function isLikelyMobileDevice() {
      const hasTouch = navigator.maxTouchPoints > 0 || 'ontouchstart' in window;
      const coarsePointer = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
      const smallScreen = window.matchMedia && window.matchMedia(`(max-width: ${MAX_MOBILE_WIDTH_PX}px)`).matches;
      return hasTouch && (coarsePointer || smallScreen);
    }

    function getGeolocationErrorMessage(error, isPermissionRequest = false) {
      if (!(error && typeof error === 'object' && 'code' in error)) {
        return isPermissionRequest
          ? 'No hemos podido solicitar el permiso de ubicación en el móvil.'
          : 'No hemos podido obtener tu ubicación GPS.';
      }

      if (error.code === GEOLOCATION_PERMISSION_DENIED) {
        return isPermissionRequest
          ? 'No has concedido permiso de ubicación en el móvil.'
          : 'Has denegado el permiso de ubicación.';
      }
      if (error.code === GEOLOCATION_POSITION_UNAVAILABLE) {
        return 'No se ha podido obtener tu ubicación.';
      }
      if (error.code === GEOLOCATION_TIMEOUT) {
        return 'Se agotó el tiempo al intentar obtener tu ubicación.';
      }
      return isPermissionRequest
        ? 'No hemos podido solicitar el permiso de ubicación en el móvil.'
        : 'No hemos podido obtener tu ubicación GPS.';
    }

    function isValidCadastralRef(val) {
      return /^[A-Z0-9]{20}$/.test(val.trim().toUpperCase());
    }

    function validate(nombre, email, cadastralRef, consent) {
      let ok = true;

      if (!nombre.trim()) {
        setError('nombre', true);
        ok = false;
      } else {
        setError('nombre', false);
      }

      if (!email.trim() || !isValidEmail(email)) {
        setError('email', true);
        ok = false;
      } else {
        setError('email', false);
      }

      if (!cadastralRef.trim() || !isValidCadastralRef(cadastralRef)) {
        setError('cadastral-reference', true);
        ok = false;
      } else {
        setError('cadastral-reference', false);
      }

      if (!consent) {
        setCheckboxError(true);
        ok = false;
      } else {
        setCheckboxError(false);
      }

      return ok;
    }

    $('signup-form').addEventListener('submit', async function (e) {
      e.preventDefault();

      const nombre         = $('nombre').value;
      const email          = $('email').value;
      const cadastralRef   = $('cadastral-reference').value;
      const consent        = $('consent').checked;
      const turnstileToken = document.querySelector('[name="cf-turnstile-response"]')?.value || '';

      hideServerError();
      $('cadastral-reference-duplicate-error').classList.add('hidden');

      if (!validate(nombre, email, cadastralRef, consent)) return;

      const btn = $('submit-btn');
      btn.disabled = true;
      btn.textContent = 'Enviando…';

      try {
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nombre: nombre.trim(),
            email: email.trim(),
            cadastral_reference: cadastralRef.trim().toUpperCase(),
            turnstileToken,
          })
        });

        if (res.ok) {
          $('form-section').classList.add('hidden');
          $('thanks').classList.remove('hidden');
          $('thanks-name').textContent = nombre.trim().split(' ')[0];
        } else {
          const data = await res.json().catch(() => ({}));

          if (res.status === 409) {
            $('cadastral-reference-duplicate-error').classList.remove('hidden');
          } else {
            showServerError(
              data.error ||
              'Ha ocurrido un error al registrar tus datos. Por favor, inténtalo de nuevo.'
            );
          }

          btn.disabled = false;
          btn.textContent = 'Registrar mi interés';
        }
      } catch {
        showServerError('No se ha podido conectar con el servidor. Comprueba tu conexión e inténtalo de nuevo.');
        btn.disabled = false;
        btn.textContent = 'Registrar mi interés';
      }
    });

    // Auto-uppercase the cadastral reference as the user types
    $('cadastral-reference').addEventListener('input', function () {
      const pos = this.selectionStart;
      this.value = this.value.toUpperCase();
      this.setSelectionRange(pos, pos);

      const val = this.value.trim();
      if (!isValidCadastralRef(val)) {
        setCadastralAddress('');
        return;
      }

      // Debounce address lookup when reference is valid
      clearTimeout(window._cadastralAddressTimer);
      window._cadastralAddressTimer = setTimeout(async function () {
        try {
          const res = await fetch('/api/address-from-cadastral-reference?reference=' + encodeURIComponent(val));
          if (!res.ok) return;
          const data = await res.json().catch(() => ({}));
          setCadastralAddress(data.address || '');
        } catch {
          // Fail silently — address display is informational only
        }
      }, 300);
    });

    $('cadastral-reference-gps-btn').addEventListener('click', async function () {
      hideServerError();
      setGpsError('');
      setGpsStatus('');
      setGpsWarning('');
      setCadastralAddress('');

      if (!navigator.geolocation) {
        setGpsError('Tu navegador no permite geolocalización.');
        return;
      }

      const gpsBtn = this;
      gpsBtn.disabled = true;

      const MAX_RETRIES = 5;
      const ACCURACY_THRESHOLD_M = 50;
      const GEOLOCATION_OPTIONS = {
        enableHighAccuracy: true,
        timeout: 15000,
        maximumAge: 0,
      };

      let bestPosition = null;
      let initialPosition = null;

      try {
        const isHome = window.confirm('¿Estás en casa en este momento?');
        if (!isHome) return;

        if (isLikelyMobileDevice()) {
          let permissionState = 'prompt';
          if (navigator.permissions && typeof navigator.permissions.query === 'function') {
            try {
              const permission = await navigator.permissions.query({ name: 'geolocation' });
              permissionState = permission.state;
            } catch (error) {
              console.debug('Permissions API geolocation check failed', error);
            }
          }

          if (permissionState === 'denied') {
            setGpsError('No has concedido permiso de ubicación en el móvil.');
            return;
          }

          if (permissionState !== 'granted') {
            setGpsStatus('Solicitando permiso de ubicación…');
            try {
              initialPosition = await new Promise(function (resolve, reject) {
                navigator.geolocation.getCurrentPosition(resolve, reject, GEOLOCATION_OPTIONS);
              });
            } catch (error) {
              setGpsError(getGeolocationErrorMessage(error, true));
              return;
            }
          }
        }

        for (let attempt = 1; attempt <= MAX_RETRIES; attempt++) {
          setGpsStatus(`Obteniendo tu ubicación GPS… (intento ${attempt} de ${MAX_RETRIES})`);

          let position;
          try {
            if (attempt === 1 && initialPosition) {
              position = initialPosition;
            } else {
              position = await new Promise(function (resolve, reject) {
                navigator.geolocation.getCurrentPosition(resolve, reject, GEOLOCATION_OPTIONS);
              });
            }
          } catch (error) {
            setGpsError(getGeolocationErrorMessage(error));
            return;
          }

          if (bestPosition === null || position.coords.accuracy < bestPosition.coords.accuracy) {
            bestPosition = position;
          }

          if (position.coords.accuracy <= ACCURACY_THRESHOLD_M) {
            break;
          }
        }

        setGpsStatus('');

        if (!bestPosition) {
          setGpsError('No hemos podido obtener tu ubicación GPS.');
          return;
        }

        const accuracyExceeded = bestPosition.coords.accuracy > ACCURACY_THRESHOLD_M;

        const res = await fetch('/api/cadastral-reference-from-coordinates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            latitude: bestPosition.coords.latitude,
            longitude: bestPosition.coords.longitude,
          })
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.cadastral_reference) {
          setGpsError(
            data.error ||
            'No hemos podido obtener la Referencia Catastral con tu ubicación.'
          );
          return;
        }

        $('cadastral-reference').value = data.cadastral_reference.toUpperCase();
        setError('cadastral-reference', false);
        setCadastralAddress(data.address || '');

        if (accuracyExceeded) {
          const accuracy = Math.round(bestPosition.coords.accuracy);
          setGpsWarning(
            `⚠️ La precisión GPS obtenida es baja (±${accuracy} m). Verifica que la referencia catastral corresponde a tu vivienda.`
          );
        }
      } finally {
        setGpsStatus('');
        gpsBtn.disabled = false;
      }
    });
  })();
</script>
{% endblock %}
